{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resbud.example/schemas/paper-draft.schema.json",
  "title": "Resbud Paper Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "abstract",
    "keywords",
    "sections",
    "references",
    "review_warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "abstract": {
      "type": "string",
      "maxLength": 6000
    },
    "keywords": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "sections": {
      "type": "array",
      "description": "Section IDs must be unique within one paper draft.",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading",
          "content",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "content": {
            "type": "string",
            "maxLength": 25000000
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "needs_input",
              "not_applicable"
            ]
          }
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "raw_text": {
            "type": ["string", "null"]
          },
          "authors": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "year": {
            "type": ["integer", "null"]
          },
          "title": {
            "type": ["string", "null"]
          },
          "venue": {
            "type": ["string", "null"]
          },
          "volume": {
            "type": ["string", "null"]
          },
          "issue": {
            "type": ["string", "null"]
          },
          "pages": {
            "type": ["string", "null"]
          },
          "publisher": {
            "type": ["string", "null"]
          },
          "doi": {
            "type": ["string", "null"]
          },
          "url": {
            "type": ["string", "null"]
          },
          "provenance": {
            "type": ["string", "null"],
            "enum": ["user_supplied", "extracted", "verified", "placeholder", null]
          },
          "verification_status": {
            "type": ["string", "null"],
            "enum": ["unverified", "verified", "incomplete", "disputed", null]
          }
        }
      }
    },
    "review_warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "MISSING_METHOD",
              "MISSING_DATASET_DETAILS",
              "MISSING_RESULTS",
              "MISSING_LIMITATIONS",
              "CITATION_NEEDED",
              "REFERENCE_INCOMPLETE",
              "CLAIM_NEEDS_REVIEW",
              "INPUT_CONFLICT",
              "SECTION_NOT_APPLICABLE",
              "GENERAL_REVIEW"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "section_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          }
        }
      }
    }
  }
}
