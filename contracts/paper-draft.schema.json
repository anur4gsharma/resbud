{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resbud.example/schemas/paper-draft.schema.json",
  "title": "Resbud Paper Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "abstract",
    "keywords",
    "sections",
    "references",
    "review_warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "abstract": {
      "type": "string",
      "maxLength": 6000
    },
    "keywords": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "sections": {
      "type": "array",
      "description": "Section IDs must be unique within one paper draft.",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading",
          "content",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "content": {
            "type": "string",
            "maxLength": 25000000
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "needs_input",
              "not_applicable"
            ]
          }
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "raw_text": {
            "type": ["string", "null"]
          },
          "authors": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "year": {
            "type": ["integer", "null"]
          },
          "title": {
            "type": ["string", "null"]
          },
          "venue": {
            "type": ["string", "null"]
          },
          "volume": {
            "type": ["string", "null"]
          },
          "issue": {
            "type": ["string", "null"]
          },
          "pages": {
            "type": ["string", "null"]
          },
          "publisher": {
            "type": ["string", "null"]
          },
          "doi": {
            "type": ["string", "null"]
          },
          "url": {
            "type": ["string", "null"]
          },
          "provenance": {
            "type": ["string", "null"],
            "enum": ["user_supplied", "extracted", "verified", "placeholder", "crossref", "openalex", "semantic_scholar", "doi_org", null]
          },
          "verification_status": {
            "type": ["string", "null"],
            "enum": ["unverified", "verified", "incomplete", "disputed", "user_provided", "flagged_missing_metadata", null]
          },
          "isbn_or_issn": {
            "type": ["string", "null"],
            "maxLength": 50
          },
          "access_date": {
            "type": ["string", "null"],
            "maxLength": 50
          },
          "publication_type": {
            "type": ["string", "null"],
            "enum": [
              "journal_article",
              "conference_paper",
              "book",
              "book_chapter",
              "thesis",
              "technical_report",
              "standard",
              "patent",
              "website",
              "software_documentation",
              "preprint",
              null
            ]
          },
          "citation_number": {
            "type": ["integer", "null"]
          },
          "citation_locations": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "is_cited": {
            "type": ["boolean", "null"]
          },
          "review_warning": {
            "type": ["string", "null"],
            "maxLength": 500
          }
        }
      }
    },
    "review_warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "MISSING_METHOD",
              "MISSING_DATASET_DETAILS",
              "MISSING_RESULTS",
              "MISSING_LIMITATIONS",
              "CITATION_NEEDED",
              "REFERENCE_INCOMPLETE",
              "CLAIM_NEEDS_REVIEW",
              "INPUT_CONFLICT",
              "SECTION_NOT_APPLICABLE",
              "GENERAL_REVIEW"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "section_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          }
        }
      }
    },
    "page_layout": {
      "type": "string",
      "enum": [
        "single_column",
        "two_column_academic"
      ],
      "default": "single_column"
    },
    "author_info": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "affiliation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "document_template": {
      "type": "string",
      "maxLength": 50,
      "default": "default"
    },
    "authors": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 1
          },
          "affiliation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 50
            }
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 150
          },
          "role_or_title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 150
          },
          "is_corresponding": {
            "type": "boolean",
            "default": false
          },
          "funding_acknowledgment": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "affiliations": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "institution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "department": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "institution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "city": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 150
          },
          "state": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 150
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 150
          }
        }
      }
    },
    "figures": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "filename",
          "caption"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "storage_key": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "data_uri": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 15000000
          },
          "width": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "height": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "mime_type": {
            "type": "string",
            "maxLength": 100,
            "default": "image/png"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "enum": [
              "flowchart",
              "architecture_diagram",
              "screenshot",
              "graph",
              "photograph",
              "experimental_result",
              "table_image",
              "other"
            ],
            "default": "other"
          },
          "related_section": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "target_anchor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "placement_rationale": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "preferred_placement": {
            "type": "string",
            "enum": [
              "after_paragraph",
              "top_of_column",
              "bottom_of_column",
              "inline"
            ],
            "default": "after_paragraph"
          },
          "column_span": {
            "type": "string",
            "enum": [
              "column_width",
              "full_width"
            ],
            "default": "column_width"
          },
          "figure_order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 1
          },
          "referenced_in_text": {
            "type": "boolean",
            "default": false
          },
          "placement_status": {
            "type": "string",
            "enum": [
              "assigned",
              "suggested",
              "unplaced",
              "omitted"
            ],
            "default": "unplaced"
          }
        }
      }
    }
  }
}
