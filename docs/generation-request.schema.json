{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resbud.example/schemas/generation-request.schema.json",
  "title": "Resbud Generation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "source_draft",
    "references",
    "preferences"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "research_field",
        "research_question",
        "objectives",
        "claimed_contribution",
        "methodology_status",
        "dataset_or_materials_status",
        "results_status",
        "limitations_status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "research_field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "research_question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "claimed_contribution": {
          "type": "string",
          "maxLength": 4000
        },
        "methodology_status": {
          "type": "string",
      "description": "unknown means the user has not supplied this fact; other non-provided values are explicit states.",
          "enum": [
            "provided",
            "not_available",
            "not_applicable",
            "unknown"
          ]
        },
        "methodology": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 12000
        },
        "dataset_or_materials_status": {
          "type": "string",
      "description": "unknown means the user has not supplied this fact; other non-provided values are explicit states.",
          "enum": [
            "provided",
            "not_available",
            "not_applicable",
            "unknown"
          ]
        },
        "dataset_or_materials": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        },
        "results_status": {
          "type": "string",
      "description": "unknown means the user has not supplied this fact; not_collected is an explicit state.",
          "enum": [
            "provided",
            "not_collected",
            "not_available",
            "not_applicable",
            "unknown"
          ]
        },
        "results": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 12000
        },
        "limitations_status": {
          "type": "string",
      "description": "unknown means the user has not supplied this fact; not_identified is an explicit state.",
          "enum": [
            "provided",
            "not_identified",
            "not_available",
            "not_applicable",
            "unknown"
          ]
        },
        "limitations": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"methodology_status": {"const": "provided"}},
            "required": ["methodology_status"]
          },
          "then": {
            "required": ["methodology"],
            "properties": {"methodology": {"type": "string", "minLength": 1, "pattern": "[\\s\\S]*\\S[\\s\\S]*"}}
          }
        },
        {
          "if": {
            "properties": {"dataset_or_materials_status": {"const": "provided"}},
            "required": ["dataset_or_materials_status"]
          },
          "then": {
            "required": ["dataset_or_materials"],
            "properties": {"dataset_or_materials": {"type": "string", "minLength": 1, "pattern": "[\\s\\S]*\\S[\\s\\S]*"}}
          }
        },
        {
          "if": {
            "properties": {"results_status": {"const": "provided"}},
            "required": ["results_status"]
          },
          "then": {
            "required": ["results"],
            "properties": {"results": {"type": "string", "minLength": 1, "pattern": "[\\s\\S]*\\S[\\s\\S]*"}}
          }
        },
        {
          "if": {
            "properties": {"limitations_status": {"const": "provided"}},
            "required": ["limitations_status"]
          },
          "then": {
            "required": ["limitations"],
            "properties": {"limitations": {"type": "string", "minLength": 1, "pattern": "[\\s\\S]*\\S[\\s\\S]*"}}
          }
        }
      ]
    },
    "source_draft": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000,
      "pattern": "[\\s\\S]*\\S[\\s\\S]*",
      "description": "Non-whitespace source text; maximum 50,000 characters."
    },
    "references": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "raw_text": {
            "type": ["string", "null"]
          },
          "authors": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "year": {
            "type": ["integer", "null"]
          },
          "title": {
            "type": ["string", "null"]
          },
          "venue": {
            "type": ["string", "null"]
          },
          "volume": {
            "type": ["string", "null"]
          },
          "issue": {
            "type": ["string", "null"]
          },
          "pages": {
            "type": ["string", "null"]
          },
          "publisher": {
            "type": ["string", "null"]
          },
          "doi": {
            "type": ["string", "null"]
          },
          "url": {
            "type": ["string", "null"]
          },
          "provenance": {
            "type": ["string", "null"],
            "enum": ["user_supplied", "extracted", "verified", "placeholder", "crossref", "openalex", "semantic_scholar", "doi_org", null]
          },
          "verification_status": {
            "type": ["string", "null"],
            "enum": ["unverified", "verified", "incomplete", "disputed", "user_provided", "flagged_missing_metadata", null]
          },
          "isbn_or_issn": {
            "type": ["string", "null"],
            "maxLength": 50
          },
          "access_date": {
            "type": ["string", "null"],
            "maxLength": 50
          },
          "publication_type": {
            "type": ["string", "null"],
            "enum": [
              "journal_article",
              "conference_paper",
              "book",
              "book_chapter",
              "thesis",
              "technical_report",
              "standard",
              "patent",
              "website",
              "software_documentation",
              "preprint",
              null
            ]
          },
          "citation_number": {
            "type": ["integer", "null"]
          },
          "citation_locations": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "is_cited": {
            "type": ["boolean", "null"]
          },
          "review_warning": {
            "type": ["string", "null"],
            "maxLength": 500
          }
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_word_count",
        "desired_sections",
        "citation_style"
      ],
      "properties": {
        "target_word_count": {
          "type": "integer",
          "minimum": 500,
          "maximum": 8000
        },
        "desired_sections": {
          "type": "array",
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          }
        },
        "citation_style": {
          "type": "string",
          "enum": [
            "user_supplied",
            "apa_7",
            "ieee",
            "other"
          ]
        },
        "page_layout": {
          "type": "string",
          "enum": [
            "single_column",
            "two_column_academic"
          ],
          "default": "single_column"
        },
        "document_template": {
          "type": "string",
          "maxLength": 50,
          "default": "default"
        },
        "include_review_notes_appendix": {
          "type": "boolean",
          "default": false
        },
        "authors": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50,
                "default": 1
              },
              "affiliation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 50
                }
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 150
              },
              "role_or_title": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 150
              },
              "is_corresponding": {
                "type": "boolean",
                "default": false
              },
              "funding_acknowledgment": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            }
          }
        },
        "affiliations": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "institution"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              "department": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 300
              },
              "institution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "city": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 150
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 150
              },
              "country": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 150
              }
            }
          }
        },
        "figures": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "filename",
              "caption"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "caption": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "storage_key": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "data_uri": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 15000000
              },
              "width": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              },
              "height": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              },
              "mime_type": {
                "type": "string",
                "maxLength": 100,
                "default": "image/png"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              },
              "category": {
                "type": "string",
                "enum": [
                  "flowchart",
                  "architecture_diagram",
                  "screenshot",
                  "graph",
                  "photograph",
                  "experimental_result",
                  "table_image",
                  "other"
                ],
                "default": "other"
              },
              "related_section": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              },
              "target_anchor": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 300
              },
              "placement_rationale": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              },
              "preferred_placement": {
                "type": "string",
                "enum": [
                  "after_paragraph",
                  "top_of_column",
                  "bottom_of_column",
                  "inline"
                ],
                "default": "after_paragraph"
              },
              "column_span": {
                "type": "string",
                "enum": [
                  "column_width",
                  "full_width"
                ],
                "default": "column_width"
              },
              "figure_order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50,
                "default": 1
              },
              "referenced_in_text": {
                "type": "boolean",
                "default": false
              },
              "placement_status": {
                "type": "string",
                "enum": [
                  "assigned",
                  "suggested",
                  "unplaced",
                  "omitted"
                ],
                "default": "unplaced"
              }
            }
          }
        }
      }
    }
  }
}
