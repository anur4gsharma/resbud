# Placeholder configuration. Never put a real credential in this file.
RESBUD_ENV=development
# Explicitly selects the deterministic demo provider; production rejects this mode.
RESBUD_GENERATION_PROVIDER=fake
# Configure a model available to your OpenAI project when selecting RESBUD_GENERATION_PROVIDER=openai.
RESBUD_PROVIDER_MODEL=
RESBUD_PROVIDER_MAX_OUTPUT_TOKENS=12000
RESBUD_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
RESBUD_PROVIDER_READ_TIMEOUT_SECONDS=90
RESBUD_PROVIDER_API_KEY=replace-with-your-local-secret
RESBUD_AUTH_ISSUER=
RESBUD_AUTH_AUDIENCE=
RESBUD_CORS_ALLOWED_ORIGINS=[]
RESBUD_MAX_REQUEST_BODY_BYTES=4194304
