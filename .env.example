# Resbud API Configuration Template
# Copy this file to `backend/.env` for local development.
# In production, inject values via your cloud secrets manager or orchestration environment.
# NEVER commit a real secret key to version control.

# Environment: "development", "test", or "production"
# Production enforces strict authentication, rate limits, and rejects fake providers.
RESBUD_ENV=development

# Generation Provider: "fake", "openai", or "disabled"
# "fake" is deterministic and offline (only allowed in development/test).
# "openai" uses the official OpenAI API adapter.
RESBUD_GENERATION_PROVIDER=fake

# Model Configuration (Required when RESBUD_GENERATION_PROVIDER=openai)
# Example: gpt-4o, gpt-4o-mini
RESBUD_PROVIDER_MODEL=

# Secret Provider API Key (Required when RESBUD_GENERATION_PROVIDER=openai)
RESBUD_PROVIDER_API_KEY=replace-with-your-local-secret

# Generation Resource Bounds
RESBUD_PROVIDER_MAX_OUTPUT_TOKENS=12000
RESBUD_PROVIDER_CONNECT_TIMEOUT_SECONDS=5.0
RESBUD_PROVIDER_READ_TIMEOUT_SECONDS=90.0

# Authentication (Required in production)
# JWT Issuer URL (must be valid HTTPS in production, e.g., https://auth.resbud.example.com/)
RESBUD_AUTH_ISSUER=
# Expected JWT Audience claim
RESBUD_AUTH_AUDIENCE=
# HMAC-SHA256 Signing Key for token validation (minimum 32 characters in production)
RESBUD_AUTH_SIGNING_KEY=

# Rate Limiting (Sliding-window per IP / client token)
RESBUD_RATE_LIMIT_PER_MINUTE=60

# CORS Allowed Origins (JSON array of exact HTTP/HTTPS origins, e.g. ["https://app.resbud.example.com"])
# Wildcards are rejected.
RESBUD_CORS_ALLOWED_ORIGINS=[]

# Request Boundary Limits (Maximum body payload in bytes; default 4MB = 4194304)
RESBUD_MAX_REQUEST_BODY_BYTES=4194304
